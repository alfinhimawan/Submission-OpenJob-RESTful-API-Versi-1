# HTTP server
HOST=localhost
PORT=3000

# PostgreSQL (dibaca otomatis oleh pg dan node-pg-migrate)
PGUSER=
PGPASSWORD=
PGDATABASE=
PGHOST=localhost
PGPORT=5432

# JWT: isi dengan string acak yang panjang (jangan dibagikan)
ACCESS_TOKEN_KEY=
REFRESH_TOKEN_KEY=

# Opsional (nilai default ditampilkan)
ACCESS_TOKEN_AGE=3h
REFRESH_TOKEN_AGE=7d
