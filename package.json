{
  "name": "openjob-restful-api-versi1",
  "version": "1.0.0",
  "description": "OpenJob RESTful API Versi 1 - Submission Belajar Fundamental Back-End dengan JavaScript",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:dev": "nodemon src/server.js",
    "migrate": "node-pg-migrate -r dotenv/config",
    "migrate:up": "node-pg-migrate -r dotenv/config up",
    "migrate:down": "node-pg-migrate -r dotenv/config down",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "joi": "^18.3.1",
    "jsonwebtoken": "^9.0.3",
    "nanoid": "^6.0.2",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10"
  }
}
